{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": false,
    "esModuleInterop": true
  },
  "include": [
    "next-env.d.ts",
    ".next-build/types/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "next.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    ".next-build/dev/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts",
    ".next-local/types/**/*.ts",
    ".next-local/dev/types/**/*.ts",
    "prisma/*.ts",
    "prisma.config.ts",
    "vitest.backend.config.ts",
    "playwright.backend.config.ts",
    ".next-backend/types/**/*.ts",
    ".next-backend/dev/types/**/*.ts",
    "neon.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "reference",
    ".next",
    ".next-local",
    ".next-e2e",
    ".ui-reference",
    ".next-build/**/* *.ts"
  ]
}
