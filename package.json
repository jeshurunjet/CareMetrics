{
  "name": "caremetrics",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -p ${PORT:-8443}",
    "build": "NEXT_BUILD_DIR=.next-build next build --webpack",
    "start": "NEXT_BUILD_DIR=.next-build next start -p ${PORT:-8443}",
    "typecheck": "NEXT_BUILD_DIR=.next-build next typegen && tsc --noEmit",
    "format": "oxfmt src tests scripts next.config.ts vitest.config.ts playwright.config.ts eslint.config.mjs postcss.config.mjs",
    "lint": "eslint . --max-warnings=0",
    "format:check": "oxfmt --check src tests scripts next.config.ts vitest.config.ts playwright.config.ts eslint.config.mjs postcss.config.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:production": "node scripts/verify-production.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "^16.3.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.13.0 <23 || >=24.0.0"
  },
  "packageManager": "pnpm@10.15.1"
}
