# Mutually exclusive modes. Existing Figma preview is development-only.
CAREMETRICS_BACKEND_MODE=disabled
CAREMETRICS_UI_PREVIEW=true
# To test real authentication: BACKEND_MODE=database, UI_PREVIEW=false.
# Server-only runtime URL: Neon pooled hostname; sslmode=verify-full.
DATABASE_URL=
# Server-only migrations/maintenance: isolated Neon direct hostname; sslmode=verify-full.
DATABASE_URL_UNPOOLED=
# Optional legacy alias for the direct URL (not used when UNPOOLED is set).
DIRECT_URL=
# Generate a unique random secret of at least 32 characters; never commit values.
AUTH_SECRET=
# Exact trusted origin. Production requires HTTPS. Local nonproduction may use localhost HTTP.
AUTH_URL=http://localhost:8443
# Optional fictional seed only; NEVER enable in production.
CAREMETRICS_SEED_CONFIRM=
CAREMETRICS_SEED_DATABASE_NAME=
# Path to owner-only 0600 JSON {fictional account email: generated password} outside the repo.
CAREMETRICS_SEED_CREDENTIALS_FILE=
# Reserved; no private file service is enabled in 2A.
BLOB_READ_WRITE_TOKEN=
