# Mutually exclusive modes. Existing Figma preview is development-only.
CAREMETRICS_BACKEND_MODE=disabled
CAREMETRICS_UI_PREVIEW=true
# To test real authentication: BACKEND_MODE=database, UI_PREVIEW=false.
# Server-only runtime URL: Neon pooled hostname; sslmode=verify-full.
DATABASE_URL=
# Server-only migrations/maintenance: isolated Neon direct hostname; sslmode=verify-full.
DATABASE_URL_UNPOOLED=
# Optional legacy alias for the direct URL (not used when UNPOOLED is set).
DIRECT_URL=
# Generate a unique random secret of at least 32 characters; never commit values.
AUTH_SECRET=
# Exact trusted origin. Production requires HTTPS. Local nonproduction may use localhost HTTP.
AUTH_URL=http://localhost:8443
# Optional fictional seed only; NEVER enable in production.
CAREMETRICS_SEED_CONFIRM=
CAREMETRICS_SEED_DATABASE_NAME=
# Path to owner-only 0600 JSON {fictional account email: generated password} outside the repo.
CAREMETRICS_SEED_CREDENTIALS_FILE=
# Reserved; no private file service is enabled in 2A.
BLOB_READ_WRITE_TOKEN=

# GPS clock-in stays disabled without explicit server-controlled organisation policies.
# Production is locked off in Phase 2E. Never copy test fixtures into production.
CAREMETRICS_GPS_POLICIES=
CAREMETRICS_GPS_TEST_POLICY_ACK=

# Clock-out policy is separate. No-location is development test-only; location-required is unavailable.
CAREMETRICS_CLOCK_OUT_POLICIES=
CAREMETRICS_CLOCK_OUT_TEST_POLICY_ACK=

# Phase 2I deployment handover (no deployment performed):
# Hosted candidate: BACKEND_MODE=database, UI_PREVIEW=false, AUTH_URL=exact HTTPS origin.
# Use a separately reviewed environment-specific Neon branch, never phase-2a/local-test.
# Do not set seed confirmations, seed credentials paths or attendance test acknowledgements.
# NODE_ENV/Vercel production rejects those fictional test settings.
# Keep every DATABASE/AUTH/BLOB value server-only; no NEXT_PUBLIC_ secret aliases.
# NEON_BRANCH_NAME is server-only environment identification, not browser authority.
NEON_BRANCH_NAME=

# Fictional GPS recording demo only. No defaults; see docs/gps-demo-and-visual-polish.md.
CAREMETRICS_DEPLOYMENT_KIND=
CAREMETRICS_DEMO_DATA_ACK=
CAREMETRICS_DEMO_ORGANISATION_ID=
CAREMETRICS_DEMO_GPS_POLICY=
# Separate minimum-privilege purge role; never expose to the client.
CAREMETRICS_LOCATION_PURGE_DATABASE_URL=
CRON_SECRET=

# Server-only scheduler signature verification (QStash token stays operator-only).
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Optional no-billing Google Maps evaluation only; bound to the fictional staging organisation.
# This browser SDK key is intentionally visible to authenticated map users; never use a server credential here.
# Keep its value out of Git and configure supported website/API restrictions.
CAREMETRICS_GOOGLE_MAPS_DEMO_ACK=
GOOGLE_MAPS_DEMO_BROWSER_KEY=
